# Copy to .env and adjust. Do NOT commit .env.

# ---- Public / host ----
# Hostname or IP clients use to reach streams (used to build stream URLs).
PUBLIC_HOST=localhost

# ---- MediaMTX ports ----
RTSP_PORT=8554
WEBRTC_PORT=8889
HLS_PORT=8888
MEDIAMTX_API_PORT=9997

# ---- FastAPI control plane (added in Step 2) ----
APP_PORT=8000
MEDIAMTX_API_URL=http://mediamtx:9997

# ---- Access control (Basic Auth) ----
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=changeme

# ---- Codec profile: software | jetson | rpi ----
CODEC_PROFILE=software

# ---- Cloudflare Tunnel (added in Step 7) ----
# CLOUDFLARE_TUNNEL_TOKEN=
